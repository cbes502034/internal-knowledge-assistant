# 複製成 .env 後修改；.env 不進版本控制

# --- 資料庫 ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=assistant
# 本機開發（uvicorn 直接跑）連 127.0.0.1；在 compose 內由 docker-compose.yml 覆寫成 db
DATABASE_URL=postgresql+psycopg://assistant:change-me-local-only@127.0.0.1:5432/assistant

# --- 驗證 ---
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_HOURS=8
IDLE_TIMEOUT_MIN=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=15
COOKIE_SECURE=false

# --- 模型（Ollama 的模型名稱：ollama pull bge-m3、ollama pull qwen2.5:3b）---
OLLAMA_URL=http://127.0.0.1:11434
GEN_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- 檢索（由 data/eval_cases.csv 評測校準，換資料後請重新評測）---
TOP_K=5
SEARCH_MODE=vector
KEYWORD_WEIGHT=0.3
SCORE_THRESHOLD=0.56

# --- 其他 ---
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=20
MAX_UPLOAD_MB=10

# --- Docker Compose 對外連接埠（本機已有服務占用時可改）---
DB_PORT=5432
WEB_PORT=8080
